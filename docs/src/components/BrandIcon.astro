---
interface Props {
  size?: number;
}

const { size = 36 } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<span class="brand-icon" style={`--icon-size: ${size}px`} aria-hidden="true">
  <img class="icon-light" src={`${base}generated/toolbox.svg`} alt="" width={size} height={size} />
  <img class="icon-dark" src={`${base}generated/toolbox-dark.svg`} alt="" width={size} height={size} />
</span>

<style>
  .brand-icon {
    display: block;
    width: var(--icon-size);
    height: var(--icon-size);
  }

  .brand-icon img {
    display: block;
    width: var(--icon-size);
    height: var(--icon-size);
    border-radius: 9px;
  }

  .brand-icon .icon-dark {
    display: none;
  }

  :global([data-theme="dark"]) .brand-icon .icon-light {
    display: none;
  }

  :global([data-theme="dark"]) .brand-icon .icon-dark {
    display: block;
  }
</style>
